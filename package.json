{
  "name": "mytunes-redux-reborn",
  "version": "2.3.1",
  "description": "A modern, legitimate reimagining of myTunes Redux for browsing and downloading from DAAP-compatible music shares.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build:sea": "esbuild server.js --bundle --platform=node --target=node20 --outfile=sea-main.js && node --experimental-sea-config sea-config.json",
    "gen:sea-config": "node tools/gen-sea-config.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "MyTunes Redux Reborn Contributors",
  "keywords": [
    "daap",
    "itunes",
    "music-sharing",
    "mytunes"
  ],
  "dependencies": {
    "airplay-js": "^0.3.0",
    "castv2-client": "^1.2.0",
    "music-metadata": "^12.3.3",
    "rss-parser": "^3.13.0"
  }
}
